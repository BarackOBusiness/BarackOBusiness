# dinit service to start soundboard script (still can't figure out why this one doesn't work)
type		= process
command		= bash -c "$XDG_CONFIG_HOME/scripts/soundboard/main.lua $SOUNDS_PATH"
depends-on	= pipewire
log-type	= buffer
logfile		= ${HOME}/.local/var/log/soundboard.log
env-file	= ./config/soundboard.conf
